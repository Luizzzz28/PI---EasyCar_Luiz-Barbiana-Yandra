#Arquivo de exemplo de variáveis de ambiente para o projeto Django
#Serve para definir variáveis de ambiente que podem ser usadas no projeto, como a chave secreta do Django e o modo de depuração.
#Para alterar valores de variáveis conforme necessário, copie este arquivo para um novo arquivo chamado .env e edite os valores das variáveis de ambiente conforme necessário.
#Com Copy-Item .env.example .env.
#Vai para o GIT

DJANGO_SECRET_KEY=troque-esta-chave-local
DJANGO_DEBUG=1